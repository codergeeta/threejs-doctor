{
  "name": "@threejs-doctor/cli",
  "version": "0.1.3",
  "description": "threejs-doctor CLI (scan, bench, ci)",
  "license": "MIT",
  "author": "codergeeta",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "bin": {
    "threejs-doctor": "./bin/threejs-doctor.js"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    },
    "./bin/threejs-doctor.js": "./bin/threejs-doctor.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@threejs-doctor/core": "workspace:^",
    "@threejs-doctor/rules": "workspace:^",
    "@threejs-doctor/runtime": "workspace:^",
    "@threejs-doctor/bench": "workspace:^"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codergeeta/threejs-doctor.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/codergeeta/threejs-doctor#readme",
  "bugs": {
    "url": "https://github.com/codergeeta/threejs-doctor/issues"
  },
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./bin/threejs-doctor.js": "./bin/threejs-doctor.js"
    },
    "provenance": true
  }
}
